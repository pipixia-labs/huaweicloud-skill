      "fixed_args": ["--execute", "--confirm-delivery"],
      "timeout_seconds": 1800,
      "arguments": {
        "host": {"type": "string", "flag": "--host", "required": true, "max_length": 253, "pattern": "^[A-Za-z0-9.:[\\]-]+$"},
        "user": {"type": "string", "flag": "--user", "required": true, "max_length": 64, "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"},
