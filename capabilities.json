        "allow_public_web": {"type": "boolean", "flag": "--allow-public-web", "default": false},
        "timeout": {"type": "integer", "flag": "--timeout", "default": 900, "minimum": 1, "maximum": 1800},
        "command_timeout": {"type": "integer", "flag": "--command-timeout", "default": 120, "minimum": 1, "maximum": 600}
