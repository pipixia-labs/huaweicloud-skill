      "service": "ECS",
      "operation": "CreateServers",
      "versions": ["v2"],
      "support_level": "curated",
      "cardinality": "multi_resource",
      "request_targets": {
        "path": "body.server.count",
        "kind": "requested_count",
        "identity_available_before_submit": false
      },
      "submit_receipt": {
        "fields": ["job_id", "serverIds[]"],
        "meaning": "request_accepted_only",
        "per_item_completion": false,
        "job_receipts_queryable": true
      },
      "batch_result_contract": {
        "applies_after": "submit_receipt",
        "initial_item_outcome": "outcome_unknown",
        "succeeded_when": "Every returned server ID is read back in ACTIVE state and the requested count is accounted for.",
        "partially_succeeded_when": "Only a proven subset of returned or requested servers reaches ACTIVE while another subset fails or remains unverified.",
        "failed_when": "The provider explicitly rejects the request before acceptance, or final evidence proves that no requested server was created.",
        "unknown_when": "The request was accepted but job or resource readback cannot account for every requested server."
      },
      "async_convergence": {
        "mode": "job_then_resource",
        "agent_direct_poll_supported": true,
        "public_polling_framework_required": false,
        "poll": {
          "service": "ECS",
          "operation": "ShowJob",
          "id_source": "response.job_id",
          "running_states": ["INIT", "PENDING", "RUNNING", "PROCESSING", "WAITING"],
          "success_states": ["SUCCESS", "SUCCEEDED", "COMPLETE", "COMPLETED"],
          "failure_states": ["FAIL", "FAILED", "ERROR", "CANCELLED", "CANCELED", "ROLLBACK", "ROLLED_BACK"],
          "optional_helper": "scripts/hcloud_ecs_wait_job.py"
        },
        "resource_readback": {
          "operations": ["ListServersDetails", "ShowServer"],
          "target_ids_source": "response.serverIds[]",
          "success_states": ["ACTIVE"],
          "required_after_job_success": true
        }
      },
      "evidence_sources": [
        "generated_hcloud_catalog",
        "official_sdk_request_response_schema",
        "curated_ecs_planner_and_verifiers"
      ]
    },
