{
  "schema_version": 1,
  "id": "huaweicloud-controlled-adapter-registry",
  "version": "v1",
  "description": "已废弃的宿主交接试验登记。它只关联 Action Spec 与生成 catalog，不复制 HTTP 方法、路径、完整参数或凭据；其 ready_for_handoff 仅表示历史试验可以生成 plan-only 交接候选，绝不表示真实提交可用。后续将迁移可复用映射证据到 Skill 内部受控操作登记。",
  "lifecycle": "deprecated_experimental",
  "host_authority_requirements": [
