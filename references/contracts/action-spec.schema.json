{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "huaweicloud-skill/contracts/action-spec/v1",
  "title": "Action Spec v1",
  "description": "Reviewed semantic overlay for a cloud action. API request facts remain in the generated catalog and are referenced, not copied.",
  "type": "object",
  "required": ["schema_version", "id", "lifecycle", "execution_family", "effect", "risk_tags", "tool_candidates", "preflight", "verification_profile", "output_policy"],
  "properties": {
    "schema_version": {"const": "action-spec/v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "lifecycle": {"enum": ["generated", "reviewed", "curated", "deprecated"]},
    "execution_family": {"enum": ["hcloud", "sdk", "terraform", "maas", "local"]},
    "catalog_ref": {
      "type": "object",
      "required": ["catalog_fingerprint", "service", "operation", "version"],
      "properties": {
        "catalog_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "service": {"type": "string", "minLength": 1},
        "operation": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "effect": {"enum": ["read", "create", "update", "attach", "detach", "delete", "remote_execute", "external_generation"]},
    "risk_tags": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "maturity": {"enum": ["generated", "reviewed", "curated", "deprecated"]},
    "tool_candidates": {"type": "array", "items": {"enum": ["hcloud", "sdk", "terraform", "maas", "local"]}, "minItems": 1, "uniqueItems": true},
    "preflight": {"type": "object"},
    "execution": {"type": "object"},
    "verification_profile": {"type": "string", "minLength": 1},
    "output_policy": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
